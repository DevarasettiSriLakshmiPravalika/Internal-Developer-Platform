# ─── Frontend ───────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8090
VITE_GRAFANA_URL=http://localhost:3000
VITE_PROMETHEUS_URL=http://localhost:9090
VITE_SONARQUBE_URL=http://localhost:9000
VITE_ARGOCD_URL=http://localhost:8080

# ─── Backend ────────────────────────────────────────────────────
SERVER_PORT=8090

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=forgeflow
DB_USERNAME=forgeflow
DB_PASSWORD=forgeflow
DB_ROOT_PASSWORD=change-me-locally

# JWT
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION_SECONDS=3600

# ─── GitHub Integration ─────────────────────────────────────────
# Personal access token with repo scope
GITHUB_TOKEN=
# GitHub org name (leave blank to use personal account)
GITHUB_ORG=

# ─── Docker Hub ─────────────────────────────────────────────────
DOCKERHUB_USERNAME=forgeflow

# ─── ArgoCD ─────────────────────────────────────────────────────
ARGOCD_URL=http://argocd-server:8080

# ─── SonarQube ──────────────────────────────────────────────────
SONARQUBE_URL=http://localhost:9000
SONARQUBE_TOKEN=

# ─── Grafana ────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=forgeflow

# ─── Security ───────────────────────────────────────────────────
# Keep all real secrets outside the repository (use a secrets manager in production).
